# 混合分类示例
# 结合使用层级结构和标签组织网站书签

# 1. 创建顶层分类组（非主组，用于建立层级结构）
group create --name "娱乐网站"
group create --name "学习网站"
group create --name "工作网站"

# 2. 创建详细分类组（非主组）
group create --name "视频网站"
group create --name "直播网站"
group create --name "编程学习网站"
group create --name "在线课程网站"
group create --name "技术文档网站"
group create --name "办公协作网站"

# 3. 创建标签（用于横向分类）
tag create --name "视频"
tag create --name "直播"
tag create --name "编程"
tag create --name "学习"
tag create --name "工作"
tag create --name "娱乐"
tag create --name "技术"
tag create --name "在线"

# 4. 为每个网站创建主文件组并创建文件
group create --name "youtube_bookmark"
file create --type "bookmark" --path "https://youtube.com" --group-id 10
group create --name "bilibili_bookmark"
file create --type "bookmark" --path "https://bilibili.com" --group-id 11
group create --name "twitch_bookmark"
file create --type "bookmark" --path "https://twitch.tv" --group-id 12
group create --name "github_bookmark"
file create --type "bookmark" --path "https://github.com" --group-id 13
group create --name "stackoverflow_bookmark"
file create --type "bookmark" --path "https://stackoverflow.com" --group-id 14
group create --name "coursera_bookmark"
file create --type "bookmark" --path "https://coursera.org" --group-id 15
group create --name "google_bookmark"
file create --type "bookmark" --path "https://google.com" --group-id 16
group create --name "baidu_bookmark"
file create --type "bookmark" --path "https://baidu.com" --group-id 17
group create --name "chatgpt_bookmark"
file create --type "bookmark" --path "https://chat.openai.com" --group-id 18
group create --name "drive_bookmark"
file create --type "bookmark" --path "https://drive.google.com" --group-id 19
group create --name "slack_bookmark"
file create --type "bookmark" --path "https://slack.com" --group-id 20

# 5. 建立层级分类关系（使用group_relations表）
# 娱乐网站 -> 视频网站 -> youtube_bookmark主组
group-relation create --first-group-id 1 --second-group-id 4 --relation-type 1
group-relation create --first-group-id 4 --second-group-id 13 --relation-type 1

# 娱乐网站 -> 视频网站 -> bilibili_bookmark主组
group-relation create --first-group-id 4 --second-group-id 14 --relation-type 1

# 娱乐网站 -> 直播网站 -> twitch_bookmark主组
group-relation create --first-group-id 1 --second-group-id 5 --relation-type 1
group-relation create --first-group-id 5 --second-group-id 15 --relation-type 1

# 学习网站 -> 编程学习网站 -> github_bookmark主组
group-relation create --first-group-id 2 --second-group-id 6 --relation-type 1
group-relation create --first-group-id 6 --second-group-id 16 --relation-type 1

# 学习网站 -> 编程学习网站 -> stackoverflow_bookmark主组
group-relation create --first-group-id 6 --second-group-id 17 --relation-type 1

# 学习网站 -> 在线课程网站 -> coursera_bookmark主组
group-relation create --first-group-id 2 --second-group-id 7 --relation-type 1
group-relation create --first-group-id 7 --second-group-id 18 --relation-type 1

# 学习网站 -> 技术文档网站 -> google_bookmark主组
group-relation create --first-group-id 2 --second-group-id 8 --relation-type 1
group-relation create --first-group-id 8 --second-group-id 19 --relation-type 1

# 学习网站 -> 技术文档网站 -> baidu_bookmark主组
group-relation create --first-group-id 8 --second-group-id 20 --relation-type 1

# 学习网站 -> 技术文档网站 -> chatgpt_bookmark主组
group-relation create --first-group-id 8 --second-group-id 18 --relation-type 1

# 工作网站 -> 办公协作网站 -> drive_bookmark主组
group-relation create --first-group-id 3 --second-group-id 9 --relation-type 1
group-relation create --first-group-id 9 --second-group-id 19 --relation-type 1

# 工作网站 -> 办公协作网站 -> slack_bookmark主组
group-relation create --first-group-id 9 --second-group-id 20 --relation-type 1

# 6. 建立标签分类关系（使用group_tags表）
# 为分类组添加标签，实现横向分类
group-tag create --group-id 1 --tag-id 6  # 娱乐网站 - 娱乐标签
group-tag create --group-id 2 --tag-id 4  # 学习网站 - 学习标签
group-tag create --group-id 3 --tag-id 5  # 工作网站 - 工作标签

group-tag create --group-id 4 --tag-id 1  # 视频网站 - 视频标签
group-tag create --group-id 5 --tag-id 2  # 直播网站 - 直播标签
group-tag create --group-id 6 --tag-id 3  # 编程学习网站 - 编程标签
group-tag create --group-id 7 --tag-id 8  # 在线课程网站 - 在线标签
group-tag create --group-id 8 --tag-id 7  # 技术文档网站 - 技术标签
group-tag create --group-id 9 --tag-id 5  # 办公协作网站 - 工作标签

# 为具体网站主组添加标签
group-tag create --group-id 13 --tag-id 1  # youtube - 视频标签
group-tag create --group-id 14 --tag-id 1  # bilibili - 视频标签
group-tag create --group-id 15 --tag-id 2  # twitch - 直播标签
group-tag create --group-id 16 --tag-id 3  # github - 编程标签
group-tag create --group-id 17 --tag-id 3  # stackoverflow - 编程标签
group-tag create --group-id 18 --tag-id 8  # coursera - 在线标签
group-tag create --group-id 19 --tag-id 7  # google - 技术标签
group-tag create --group-id 20 --tag-id 7  # baidu - 技术标签
group-tag create --group-id 18 --tag-id 7  # chatgpt - 技术标签
group-tag create --group-id 19 --tag-id 5  # drive - 工作标签
group-tag create --group-id 20 --tag-id 5  # slack - 工作标签