# 1. 创建主文件组（a类非主文件组）
group create --name "视频网页";
group create --name "编程教程网页";
group create --name "搜索引擎网页";
group create --name "AI网页";
group create --name "网络磁盘网页";
group create --name "云服务网页";

# 2. 创建其他非主文件组（b类非主文件组）
group create --name "娱乐网页组";
group create --name "学习网页组";
group create --name "工作资料网页组";
group create --name "总网页组";

# 3. 创建标签
tag create --name "网页";
tag create --name "视频";
tag create --name "编程";
tag create --name "搜索";
tag create --name "AI";
tag create --name "网盘";
tag create --name "云服务";
tag create --name "娱乐";
tag create --name "学习";
tag create --name "工作";

